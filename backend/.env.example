# Copy to .env and fill in. Never commit .env.
DATABASE_URL=sqlite:///./leadflow.db   # on Render this is set for you (PostgreSQL); postgres:// URLs are accepted
ENVIRONMENT=development          # "production" refuses to start with the default JWT secret
COMPANY_NAME=Kiwi Connect Digital

# --- Auth ---
JWT_SECRET=change-me             # use a long random string: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Optional: first admin is created automatically at startup if it doesn't exist
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- AI providers ---
AI_PRIMARY_PROVIDER=gemini       # gemini | groq
AI_FALLBACK_PROVIDER=groq        # used only if the primary fails after its retries; leave empty to disable
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low        # low | medium | high; low keeps token use (and rate-limit hits) down
AI_TIMEOUT_SECONDS=30
AI_MAX_ATTEMPTS=3
AI_MAX_CONCURRENCY=2             # simultaneous LLM calls
# Free-tier rate limits the scheduler stays under (it routes to the other provider, or queues, instead of hitting HTTP 429).
# Raise these on a paid plan. Use {} to switch the scheduler off.
# AI_TPM_LIMITS={"groq": 8000, "gemini": 250000}      # tokens per minute
# AI_RPM_LIMITS={"groq": 30, "gemini": 10}            # requests per minute

# --- Email (optional). Leave SMTP_HOST empty to switch email features off; nothing is faked. ---
# Gmail example: host smtp.gmail.com, port 587, starttls, username = your address, password = an APP PASSWORD
# (Google Account > Security > 2-Step Verification > App passwords), never your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls           # starttls | ssl | none
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Kiwi Connect Digital <leads@yourdomain.com>
NOTIFY_EMAIL=                    # comma-separated team inboxes alerted about hot / high-priority / needs-review enquiries
NOTIFY_ALL_ENQUIRIES=false       # true = alert those inboxes for every new enquiry
FRONTEND_URL=http://localhost:5173   # used for the "Open it" link in alert emails

# --- WhatsApp click-to-chat ---
DEFAULT_COUNTRY_CODE=91          # added to 10-digit numbers saved without a country code

# --- Business rules ---
HOT_LEAD_THRESHOLD=80
WARM_LEAD_THRESHOLD=50
DUPLICATE_SIMILARITY_THRESHOLD=0.85

# --- Rate limits (per IP per minute) ---
RATE_LIMIT_ENQUIRIES_PER_MINUTE=20
RATE_LIMIT_LOGIN_PER_MINUTE=10
